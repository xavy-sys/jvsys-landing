<li data-section-id="d97xsd" data-start="904" data-end="918">
<p data-start="906" data-end="918">Sin espacios</p>
</li>
<li data-section-id="1jetaq" data-start="919" data-end="941">
<p data-start="921" data-end="941">Sin mayúsculas extra</p>
</li>
<li data-section-id="14m1rb" data-start="942" data-end="960">
<p data-start="944" data-end="960">Sin (1) o (copy)</p>
</li>
</ul>
<hr data-start="962" data-end="965">
<h3 data-section-id="iz3" data-start="967" data-end="992">3. Ubicación correcta</h3>
<p data-start="994" data-end="1025">Debe quedar al mismo nivel que:</p>
