<h2 data-section-id="1dmfpuw" data-start="87" data-end="121">🔴 Problema real de esa sección</h2>
<div class="no-scrollbar flex min-h-36 flex-nowrap gap-0.5 overflow-auto sm:gap-1 sm:overflow-hidden xl:min-h-44 mt-1 mb-5 not-first:mt-4"><div class="border-token-border-default relative w-32 shrink-0 overflow-hidden rounded-xl border-[0.5px] md:shrink max-h-64 sm:w-[calc((100%-0.5rem)/3)] rounded-s-xl" style="aspect-ratio: 5 / 4;"><div class="group/search-image @container/search-image relative rounded-[inherit] h-full w-full" style="aspect-ratio: 5 / 4;"><button type="button" class="h-full w-full overflow-hidden rounded-[inherit]" aria-label="Abrir detalles de la imagen de Abstract backgrounds with square glowing share"><div style="width: 100%; height: 100%; opacity: 1; transform: none;"><img alt="https://images.openai.com/static-rsc-4/ZjaV8RHm-vp6x5C4PC-2nHROQvnQwK19XenDdD-o9gZ9MefwRDdFmepe1EMD2hspS0NVDx46xlW_f2b8qdGhmG6fP1hLwS0GwhRg3vkQqxQXxp2lR-sbZRurmyNZwL4vANpfHp7Z5JUo45P1wbfO23SSJFR-aAiYJLmVqkcK-k7z7H8wFMJ-W55LoHpXRXZu?purpose=fullsize" referrerpolicy="no-referrer" class="bg-token-main-surface-tertiary m-0 h-full w-full object-cover" src="./mockup-condo-admin-saas_files/XhEr0XnbUgXOb90WdDzapPfCBXi2j27_koYpAcoev2e3PbDRiBJIR9lBJXBoaUsG_b6AaQ0jzK9FZtg0Ywke76RPjHYKcMbVomYh1i0eplwjBcP3SJhZcainHYTZ_QLNyQ32Qix_7lHr9MLzQ9-di5vTp66kGxlzA9S6sn8Pl5tdEsTc5FItwivTYWQlThzt" style="object-position: 0% 50%; opacity: 1;"></div></button></div></div><div class="border-token-border-default relative w-32 shrink-0 overflow-hidden rounded-xl border-[0.5px] md:shrink max-h-64 sm:w-[calc((100%-0.5rem)/3)]" style="aspect-ratio: 5 / 4;"><div class="group/search-image @container/search-image relative rounded-[inherit] h-full w-full" style="aspect-ratio: 5 / 4;"><button type="button" class="h-full w-full overflow-hidden rounded-[inherit]" aria-label="Abrir detalles de la imagen de Abstract  Modern Technology-Inspired Background with Triangle and Square Shapes"><div style="width: 100%; height: 100%; opacity: 1; transform: none;"><img alt="https://images.openai.com/static-rsc-4/oYa5LayKDq